{
  "name": "@blankcode/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@blankcode/shared": "workspace:*",
    "@effect/sql": "^0.52.1",
    "@effect/sql-drizzle": "^0.51.0",
    "@effect/sql-pg": "^0.53.0",
    "effect": "^3.22.1",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "22",
    "@types/pg": "^8.20.4",
    "dotenv-mono": "^1.5.1",
    "drizzle-kit": "^0.31.10",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@effect/experimental": ">=0.58.0",
    "@effect/platform": ">=0.94.0",
    "drizzle-orm": ">=0.41.0"
  }
}
