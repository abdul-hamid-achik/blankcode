{
  "name": "blankcode",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bunx turbo dev",
    "build": "bunx turbo build",
    "test": "bunx turbo test",
    "lint": "bunx oxlint && bunx oxfmt --check .",
    "lint:fix": "bunx oxlint --fix && bunx oxfmt .",
    "format": "bunx oxfmt .",
    "typecheck": "bunx turbo typecheck",
    "clean": "bunx turbo clean && rm -rf node_modules",
    "db:generate": "bun run --filter @blankcode/db db:generate",
    "db:migrate": "bun run --filter @blankcode/db db:migrate",
    "db:push": "bun run --filter @blankcode/db db:push",
    "db:studio": "bun run --filter @blankcode/db db:studio",
    "content:import": "bun run --filter @blankcode/content-importer start",
    "content:validate": "bun run --filter @blankcode/exercise-validator start",
    "content:verify": "bun run --filter @blankcode/api content:verify",
    "content:generate": "bun run --filter @blankcode/exercise-generator start",
    "runners:build": "bash docker/runners/build-all.sh",
    "runners:rebuild": "docker compose up --force-recreate --no-deps runner-images",
    "prepare": "lefthook install || true",
    "knip": "bunx knip",
    "story": "bun run --filter @blankcode/web story",
    "story:build": "bun run --filter @blankcode/web story:build",
    "verify": "bun run lint && bun run typecheck && bun run test && bun run knip && bun run content:validate --strict",
    "format:check": "bunx oxfmt --check .",
    "sandbox:build": "bun run --filter @blankcode/sandbox-images start"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "knip": "^6.32.0",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "turbo": "^2.10.8",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.8",
    "@vue/compiler-core": "3.5.41",
    "@vue/compiler-dom": "3.5.41",
    "@vue/compiler-sfc": "3.5.41",
    "@vue/reactivity": "3.5.41",
    "@vue/runtime-core": "3.5.41",
    "@vue/runtime-dom": "3.5.41",
    "@vue/server-renderer": "3.5.41",
    "@vue/shared": "3.5.41",
    "vue": "3.5.41"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "bun@1.3.7"
}
