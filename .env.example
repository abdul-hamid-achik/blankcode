# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/blankcode
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=blankcode
POSTGRES_PORT=5432

# API
API_PORT=3000
API_HOST=0.0.0.0
# Nuxt dev server (docker compose maps it to 3001; `bun run dev` uses 3000+1)
CORS_ORIGIN=http://localhost:3001
NODE_ENV=development

# JWT — REQUIRED. The API refuses to boot on a missing or known-default value.
# Generate one with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Comma-separated emails granted admin endpoints
ADMIN_EMAILS=

# Frontend
# The API is mounted inside Nuxt's own server at /api, so the default is
# relative and there is nothing to proxy. Only set this if you are pointing the
# frontend at an API that lives somewhere else.
NUXT_PUBLIC_API_URL=

# Canonical origin, used for canonical tags, OG urls and the sitemap. Set this
# per environment so a preview deployment never claims to be the live site.
NUXT_PUBLIC_SITE_URL=

# Signs the weekly cron that keeps the sandbox snapshots from expiring. Without
# it that endpoint is open and anyone can spin up microVMs.
CRON_SECRET=

# AI Generation (optional — only used by `bun run content:generate`)
# Everything routes through the Vercel AI Gateway, so this is the ONLY
# credential needed. Get one at https://vercel.com/docs/ai-gateway
AI_GATEWAY_API_KEY=

# Model slug in `provider/model` form. List valid ids with:
#   bun run content:generate --models
# deepseek/deepseek-v4-flash is the cheap default; deepseek/deepseek-v4-pro or
# anthropic/claude-sonnet-5 are stronger on hard tracks.
LLM_MODEL=deepseek/deepseek-v4-flash
# Comma-separated failover models, tried if the primary is unavailable
LLM_FALLBACK_MODELS=
LLM_TEMPERATURE=0.6
LLM_MAX_TOKENS=4000
LLM_MAX_RETRIES=2

# Execution Engine
# Where submissions run:
#   docker         — local Docker daemon (development, self-hosting)
#   vercel-sandbox — Firecracker microVM per run (required on Vercel; a Function
#                    cannot start a container). Build the snapshots first with
#                    `bun run sandbox:build` and paste the ids it prints below.
EXECUTION_BACKEND=docker

# Only used when EXECUTION_BACKEND=vercel-sandbox.
SANDBOX_SNAPSHOT_TYPESCRIPT=
SANDBOX_SNAPSHOT_REACT=
SANDBOX_SNAPSHOT_VUE=
SANDBOX_SNAPSHOT_PYTHON=
SANDBOX_SNAPSHOT_GO=
SANDBOX_SNAPSHOT_RUST=

# NOTE: defaults to true in code — set it to false explicitly to run submissions
# on the host without Docker (faster local loop, but no sandbox isolation).
DOCKER_ENABLED=true
EXECUTION_TIMEOUT_MS=60000
EXECUTION_MEMORY_MB=256
EXECUTION_CPU_LIMIT=0.5

# Docker Images (only needed if DOCKER_ENABLED=true)
# Build them all with: bun run runners:build
DOCKER_IMAGE_TS=blankcode/runner-typescript:latest
DOCKER_IMAGE_PYTHON=blankcode/runner-python:latest
DOCKER_IMAGE_GO=blankcode/runner-go:latest
DOCKER_IMAGE_RUST=blankcode/runner-rust:latest
DOCKER_IMAGE_REACT=blankcode/runner-react:latest
DOCKER_IMAGE_VUE=blankcode/runner-vue:latest

# Rate Limiting
RATE_LIMIT_TTL=60000
RATE_LIMIT_MAX=100
RATE_LIMIT_AUTH_TTL=60000
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_SUBMISSION_TTL=60000
RATE_LIMIT_SUBMISSION_MAX=30
