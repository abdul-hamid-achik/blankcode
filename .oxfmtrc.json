{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 100,
  "singleQuote": true,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "es5",
  "semi": false,
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "ignorePatterns": [
    "**/node_modules",
    "**/dist",
    "**/.turbo",
    "**/coverage",
    "**/.nuxt",
    "**/.output",
    "**/.histoire",
    "**/.content-collections",
    "**/*.min.js",
    "**/*.min.css",
    "docker/**",
    "**/*.css",
    "**/*.md",
    "**/*.yml",
    "**/*.yaml"
  ]
}
