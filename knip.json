{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": ["turbo.json"]
    },
    "apps/api": {
      "project": ["src/**/*.ts"]
    },
    "apps/web": {
      "entry": [
        "content.config.ts",
        "__tests__/**/*.ts",
        "histoire.config.ts",
        "histoire.setup.ts",
        "**/*.story.vue",
        "pages/**/*.vue",
        "layouts/**/*.vue",
        "components/**/*.vue",
        "composables/**/*.ts",
        "plugins/**/*.ts",
        "middleware/**/*.ts",
        "stores/**/*.ts",
        "utils/**/*.ts"
      ],
      "project": ["**/*.{ts,vue}"]
    },
    "packages/*": {
      "project": ["src/**/*.ts"]
    },
    "tools/*": {
      "project": ["src/**/*.ts"]
    }
  },
  "ignoreDependencies": [
    "@blankcode/shared",
    "drizzle-orm",
    "vue-tsc",
    "shiki",
    "vscode-oniguruma",
    "vscode-textmate",
    "flexsearch"
  ],
  "ignoreWorkspaces": ["content"],
  "ignoreExportsUsedInFile": true
}
