{
  "name": "@blankcode/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./app": {
      "types": "./dist/app.d.ts",
      "import": "./dist/app.js"
    },
    "./run-submission": {
      "types": "./dist/modules/submissions/run-submission.d.ts",
      "import": "./dist/modules/submissions/run-submission.js"
    },
    "./execution": {
      "types": "./dist/services/execution/index.d.ts",
      "import": "./dist/services/execution/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "clean": "rm -rf dist",
    "content:verify": "bun scripts/verify-solutions.ts"
  },
  "dependencies": {
    "@blankcode/db": "workspace:*",
    "@blankcode/exercise-parser": "workspace:*",
    "@blankcode/shared": "workspace:*",
    "@effect/experimental": "^0.61.1",
    "@effect/platform": "^0.97.1",
    "@effect/platform-node": "^0.108.1",
    "@vercel/sandbox": "^2.9.2",
    "bcrypt": "^6.0.0",
    "effect": "^3.22.1",
    "jose": "^6.2.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.41.0"
  }
}
