{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "preview": true
    }
  },
  "ignoreCommand": "git diff --quiet ${VERCEL_GIT_PREVIOUS_SHA:-HEAD^} HEAD -- . ':!CHANGELOG.md' ':!CHANGELOG*' ':!AGENTS.md' ':!CLAUDE.md' ':!.github' ':!.github/**' ':!.buildkite' ':!.buildkite/**'",
  "framework": "nuxtjs",
  "installCommand": "cd ../.. && bun install --frozen-lockfile",
  "buildCommand": "cd ../.. && bunx turbo build --filter=@blankcode/web",
  "crons": [
    {
      "path": "/cron/warm-snapshots",
      "schedule": "0 6 * * 1"
    },
    {
      "path": "/cron/review-reminders",
      "schedule": "0 14 * * *"
    }
  ]
}
