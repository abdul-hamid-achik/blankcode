{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "types": ["node"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "paths": {
      "@blankcode/shared": ["../../packages/shared/src/index.ts"],
      "@blankcode/shared/*": ["../../packages/shared/src/*"],
      "@blankcode/exercise-parser": ["../../packages/exercise-parser/src/index.ts"]
    }
  },
  "include": ["./src/**/*"],
  "exclude": ["node_modules", "dist"],
  "references": [{ "path": "../../packages/shared" }, { "path": "../../packages/exercise-parser" }]
}
